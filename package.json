{
  "name": "onledger",
  "productName": "OnLedger",
  "version": "1.0.0",
  "description": "区块链地址账单查询桌面工具",
  "main": "electron/main.js",
  "author": "OnLedger",
  "license": "MIT",
  "type": "commonjs",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "dev": "concurrently -k -n vite,electron \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build:renderer": "vite build",
    "start": "npm run build:renderer && electron .",
    "dist:win": "npm run build:renderer && electron-builder --win",
    "dist:mac": "npm run build:renderer && electron-builder --mac",
    "test:providers": "node scripts/smoke-test.js",
    "dev:web": "concurrently -k -n api,vite \"cross-env PORT=8787 ALLOWED_ORIGINS=http://localhost:5173 node server/server.js\" \"vite\"",
    "server": "node server/server.js"
  },
  "dependencies": {},
  "devDependencies": {
    "@ant-design/icons": "^6.3.4",
    "@vitejs/plugin-react": "^6.3.0",
    "antd": "^6.7.0",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "dayjs": "^1.11.23",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.7",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.onledger.app",
    "productName": "OnLedger",
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "category": "public.app-category.finance",
      "target": [
        "dmg",
        "zip"
      ]
    }
  }
}
